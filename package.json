{
  "name": "shieldtrail-monorepo",
  "private": true,
  "license": "MIT",
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*",
    "examples/*"
  ],
  "scripts": {
    "build": "npm run build -w shieldtrail",
    "typecheck": "tsc -p packages/shieldtrail --noEmit",
    "test": "vitest run",
    "demo": "npm run build && tsx examples/agent-demo/src/run.ts",
    "build:web": "npm run build -w shieldtrail-web",
    "test:web": "node apps/web/e2e/smoke.mjs",
    "deploy:pages": "scripts/deploy-pages.sh",
    "shieldtrail": "node packages/shieldtrail/dist/cli.js",
    "test:panel": "npm run build && node packages/shieldtrail/e2e/panel.mjs",
    "test:next": "npm run build && node examples/next-app/e2e/panel-next.mjs"
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@opentelemetry/api": "^1.10.0",
    "@types/node": "^22.10.0",
    "@types/pg": "^8.23.1",
    "pg": "^8.23.1",
    "playwright-core": "^1.65.1",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3",
    "vitest": "^5.1.1",
    "zod": "^4.6.7"
  }
}
